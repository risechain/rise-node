# Your local settings — copy to .env. Everything else (peers, DA, version pins,
# tuning) comes from env.mainnet / env.testnet, which git pull keeps up to date.

# Required: your own L1 RPC endpoint (Sepolia for testnet, Ethereum for mainnet)
L1_RPC_URL=

# Which network preset to use (mainnet | testnet)
NETWORK=testnet

# Optional overrides — uncomment ONLY to deliberately diverge from the preset.
# Pinning tags here freezes you on that version: upgrades stop applying.
# RISE_EXEC_TAG=
# RISE_NODE_TAG=
# L1_RPC_KIND=   # standard|alchemy|quicknode|erigon|debug_geth… — 1-call-per-block receipts
# L1_TRUST_RPC=  # true to skip verifying L1 RPC responses (only for an RPC you trust)
# PUBLIC_RPC=
# RPC_GAS_CAP=
